[Unit]
Description=Sys Probe (metricas de sistema para Observability Console)
After=network.target

[Service]
Type=simple
User=probe
Group=probe
WorkingDirectory=/opt/sys-probe
ExecStart=/opt/sys-probe/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
