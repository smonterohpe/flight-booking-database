[Unit]
Description=DB Probe (metricas PostgreSQL para Observability Console)
After=network.target postgresql.service

[Service]
Type=simple
User=probe
Group=probe
WorkingDirectory=/opt/db-probe
Environment=PROBE_DATABASE_DSN=postgresql://probe_user:CHANGE_ME@localhost:5432/flight_booking
ExecStart=/opt/db-probe/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
